# ---------------------------------------------------------------------------
# Required to boot
# ---------------------------------------------------------------------------

# Neon connection string (free tier, no credit card).
# Use the POOLED url — it ends in "-pooler". https://neon.tech
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/postpilot?sslmode=require"

# 32 bytes, base64. Every platform token is sealed with this.
#   openssl rand -base64 32
# Losing it means every connected account has to be reconnected.
ENCRYPTION_KEY=""

# Bearer secret the external cron must present to /api/cron/tick.
#   openssl rand -hex 32
CRON_SECRET=""

# Public origin. Must match your OAuth redirect URIs exactly.
# Local Meta testing needs HTTPS: cloudflared tunnel --url http://localhost:3000
APP_URL="http://localhost:3000"


# ---------------------------------------------------------------------------
# LinkedIn  —  start here, it needs no review
# ---------------------------------------------------------------------------
# 1. Create a LinkedIn *Company Page* (you cannot make an app without one).
# 2. https://www.linkedin.com/developers/apps → create an app against that Page.
# 3. Products tab → add "Sign In with LinkedIn using OpenID Connect"
#    and "Share on LinkedIn". Both are self-serve; w_member_social arrives
#    without a review conversation.
# 4. Auth tab → redirect URL: http://localhost:3000/api/connect/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# REST API version, YYYYMM. LinkedIn retires versions after roughly a year.
LINKEDIN_API_VERSION="202606"


# ---------------------------------------------------------------------------
# Meta  —  one app, both Facebook Pages and Instagram
# ---------------------------------------------------------------------------
# 1. https://developers.facebook.com/apps → create a "Business" app.
# 2. Add products: "Facebook Login for Business" and "Instagram".
# 3. Leave the app in DEVELOPMENT MODE. Add yourself under App Roles.
#    In Development mode, standard access covers your own Page and your own
#    Instagram account with no App Review at all.
# 4. Facebook Login settings → Valid OAuth Redirect URI:
#    https://<your-tunnel>.trycloudflare.com/api/connect/meta/callback
#    (Meta requires HTTPS, hence the tunnel.)
# 5. Your Instagram account must be Business or Creator AND linked to a Page.
META_APP_ID=""
META_APP_SECRET=""
META_API_VERSION="v21.0"


# ---------------------------------------------------------------------------
# Supabase Storage  —  media (free tier, no credit card)
# ---------------------------------------------------------------------------
# Facebook and Instagram FETCH images from a public URL rather than accepting an
# upload, so localhost paths fail even in development. Create a PUBLIC bucket
# named "media" at https://supabase.com → Storage.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="media"


# ---------------------------------------------------------------------------
# Development convenience
# ---------------------------------------------------------------------------
# Dev mode signs you into a single workspace automatically. Swap getSession()
# in src/lib/auth.ts for Clerk when you need real accounts.
DEV_USER_EMAIL="you@localhost"
DEV_ORG_NAME="My workspace"

# Facebook Login for Business configuration id (App dashboard →
# Facebook Login for Business → Configurations). Login for Business ignores
# `scope` and takes this instead; leave empty for classic Facebook Login.
META_CONFIG_ID=""
